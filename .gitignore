# Build output - the exe and everything that runs next to it.
/bin/*
!/bin/README.md
/dcu/

# Local runtime config: holds API keys, never leaves this machine.
*.xml.local
DelphiLoop.xml

# RAD Studio local state.
*.identcache
*.local
*.dsk
*.stat
*.tvsconfig
*.otares
__history/
__recovery/
*.~*

# Compiler output that can escape the output dirs.
*.dcu
*.exe
*.map
*.rsm
*.drc
*.res
